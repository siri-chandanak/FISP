{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["event_id", "source_type", "ticker", "published_at", "ingested_at"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_type": {
      "type": "string",
      "enum": ["news", "stock"]
    },
    "ticker": {
      "type": "string",
      "minLength": 1
    },
    "headline": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "volume": {
      "type": "integer"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}